#!/usr/bin/env bash
# Применить то, что инструмент может починить, и проверить то, чего не может.
#
# Форматирование и механические правки линтера применяются к добавленным файлам и
# добавляются снова, поэтому ни один коммит не падает из-за того, что ruff починил
# бы сам. Всё, что дальше, только сообщает: ruff, mypy и набор тестов решают,
# случится коммит или нет.
#
# Ставится через scripts/install-hooks.ps1 (или .sh), который направляет
# core.hooksPath на этот каталог. Ничего машинно-специфичного здесь нет, поэтому хук
# версионируется рядом с кодом, который он проверяет.
#
# Пути обхода:
# VELLAR_SKIP_HOOK=1    пропустить хук целиком (git commit --no-verify тоже работает)
# VELLAR_SKIP_TESTS=1   применить правки и проверить типы, но не запускать pytest
set -euo pipefail

if [ "${VELLAR_SKIP_HOOK:-0}" = "1" ]; then
    echo "pre-commit: skipped (VELLAR_SKIP_HOOK=1)"
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if ! command -v uv >/dev/null 2>&1; then
    echo "pre-commit: uv is not on PATH. Install it from https://docs.astral.sh/uv/" >&2
    exit 1
fi

say() { printf '\033[36m==> %s\033[0m\n' "$1"; }
fail() { printf '\033[31m%s\033[0m\n' "$1" >&2; }

# --- Что именно коммитят -----------------------------------------------------

staged=()
while IFS= read -r line; do
    [ -n "$line" ] && staged+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

if [ ${#staged[@]} -eq 0 ]; then
    say "no Python files staged, nothing to fix"
else
    # Файл, добавленный в одном состоянии и отредактированный в другом, нельзя добавить
    # целиком: это затянуло бы в коммит недобавленные правки. Такие чинятся на диске и
    # оставляются автору, чтобы он добавил их осознанно.
    partial=""
    while IFS= read -r line; do
        [ -n "$line" ] && partial="${partial}${line}"$'\n'
    done < <(git diff --name-only -- "${staged[@]}")

    # --- Автоматические правки ----------------------------------------------------
    # Отказы здесь не смертельны: то, что ruff всё-таки починил, всё равно добавляется,
    # а
    # проверяющий проход ниже сообщит, что осталось.

    say "ruff format (applying)"
    uv run ruff format "${staged[@]}" || true

    say "ruff check --fix (applying)"
    uv run ruff check --fix "${staged[@]}" || true

    # --- Re-stage ------------------------------------------------------------

    restaged=0
    blocked=""
    for file in "${staged[@]}"; do
        # Удалён или переименован после добавления: возвращать нечего.
        if [ ! -f "$file" ]; then
            continue
        fi
        # Не тронут теми, кто чинит: делать нечего.
        if git diff --quiet -- "$file"; then
            continue
        fi
        if printf '%s' "$partial" | grep -Fxq -- "$file"; then
            blocked="${blocked}  ${file}"$'\n'
        else
            git add -- "$file"
            restaged=$((restaged + 1))
        fi
    done

    if [ "$restaged" -gt 0 ]; then
        say "re-staged $restaged file(s) after the fixers"
    fi

    if [ -n "$blocked" ]; then
        fail "pre-commit: these files were only partly staged, so the fixes went to your working tree and not into the commit:"
        printf '%s' "$blocked" >&2
        fail "Stage them (git add -u) or commit them whole, then commit again."
        exit 1
    fi
fi

# --- Verify ------------------------------------------------------------------

say "ruff check"
uv run ruff check .

say "ruff format --check"
uv run ruff format --check .

say "mypy --strict"
uv run mypy

if [ "${VELLAR_SKIP_TESTS:-0}" = "1" ]; then
    say "pytest skipped (VELLAR_SKIP_TESTS=1)"
else
    say "pytest"
    uv run pytest -q
fi

say "pre-commit: clean"
