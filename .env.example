# Скопируйте в .env и заполните. Настоящий .env не коммитят никогда.
#
# Стек Docker читает этот же файл, но перекрывает APP_ENV, POSTGRES_DSN и REDIS_DSN
# значениями, указывающими на контейнеры, — см. docker-compose.yml. Всё остальное
# отсюда работает в обоих случаях.

# --- Приложение ---
# local  = адаптеры в памяти, ни PostgreSQL, ни Redis не нужны (разработка)
# solo   = long polling против PostgreSQL этой машины, без Redis и без Docker:
#          мир сохраняется, экран, на котором стоит игрок, — нет
#          (docs/adr/0010-a-machine-without-containers.md)
# dev    = long polling против настоящих PostgreSQL и Redis
# prod   = режим вебхука против настоящих PostgreSQL и Redis
APP_ENV=local
LOG_LEVEL=INFO
# В prod журнал в JSON включён независимо от этого флага.
LOG_JSON=false

# --- Журнал (src/mmorpg/logging.py) ---
# Всё по-прежнему уходит в stdout; эти настройки говорят, пишется ли то же самое в
# файлы и сколько эти файлы держатся. В каталоге их два:
#
# logs/vellar.log    - всё подряд. Кто что нажал, с каким исходом и за сколько
#                      миллисекунд. Переворачивается в полночь и удаляется через
#                      LOG_RETENTION_DAYS дней.
# logs/important.log - то, чего уборке трогать нельзя: предупреждения, отказы и
#                      трассировки, каждая строка gold_flow, каждое несостоявшееся
#                      или отвергнутое действие, каждый старт и каждая остановка.
#
# LOG_IMPORTANT_RETENTION_DAYS=0 значит, что второй файл не удаляется вовсе, и это
# значение по умолчанию: он растёт килобайтами там, где первый растёт мегабайтами.
# Пустой LOG_DIR выключает файлы и оставляет один stdout — так и делает стек Docker,
# где журнал принадлежит собирающему его демону.
LOG_DIR=logs
LOG_RETENTION_DAYS=7
LOG_IMPORTANT_RETENTION_DAYS=0

# --- Telegram ---
BOT_TOKEN=123456:replace-with-your-token
# Настройки вебхука читаются только при APP_ENV=prod.
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-a-random-string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Сообщество (Roadmap.md, Narrative.md) ---
# Канал, куда игра пишет свою летопись, и группа, где разговаривают игроки. Оба
# принимают числовой id чата (-100...) или @username. Бот обязан быть
# администратором в канале, чтобы писать, и в группе, чтобы удалять свои сообщения
# через пять минут. Пусто — значит, этой части просто нет: локальному запуску не
# нужна ни та ни другая.
#
# GROUP_ID=* значит «любая группа, куда бота добавили». Это чтобы попробовать
# команды до того, как узнан id: добавьте бота, напишите «профиль» ответом
# кому-нибудь — и он ответит. С пустым GROUP_ID бот молчит, но пишет id увиденной
# группы в журнал (group_not_configured), поэтому нужное число можно прочитать, а не
# разыскивать.
CHANNEL_ID=
GROUP_ID=
# Необязательные ссылки, которые игра показывает игрокам («где остальные»).
CHANNEL_URL=
GROUP_URL=

# --- Смотрители ---
# Telegram-id, от которых начинается право смотрителя, через запятую. Пусто —
# значит, его нет ни у кого. Смотритель заходит в любой город, выдаёт себе золото,
# уровни и очки и лечится; id из этого списка к тому же выдаёт само право другим
# игрокам из панели, и лишить его изнутри игры нельзя — см. docs/keeper.md.
ADMIN_IDS=

# --- Мир ---
# Смена сида пересобирает весь процедурный мир заново.
WORLD_SEED=vellar-prime
# Как часто переворачивается прилавок лавки, в секундах (полчаса). У самого мира цикла
# нет: локация держит свою карту, пока её не вычистят.
SHOP_ROTATION_SECONDS=1800

# --- PostgreSQL (не читается при APP_ENV=local) ---
# В режиме solo это база на этой машине, и её же заводит «Start.bat setup-db»: роль
# vellar с паролем POSTGRES_PASSWORD ниже, владеющая базой того же имени. Укажите
# адрес в другое место — игра и миграции пойдут туда.
POSTGRES_DSN=postgresql://vellar:vellar@localhost:5432/vellar
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20
# Пароль роли, под которой подключается игра: его берут docker-compose.yml для
# контейнера и «Start.bat setup-db» для PostgreSQL, установленного на этой машине.
# Смените его, прежде чем выставлять PostgreSQL дальше loopback.
POSTGRES_PASSWORD=vellar

# --- Redis (не читается, когда APP_ENV равен local или solo) ---
REDIS_DSN=redis://localhost:6379/0

# --- Связь, оборвавшаяся на ходу (docs/architecture.md) ---
# Упавшее соединение пул заменит сам; эти настройки управляют вызовом, который был
# в воздухе, когда оно упало: сколько раз он повторяется и сколько ждать перед
# каждым повтором — пауза удваивается до потолка. Ничто, что уже могло изменить
# мир, не повторяется: см. docs/adr/0009-repeating-a-lost-query.md.
RECONNECT_ATTEMPTS=5
RECONNECT_DELAY_SECONDS=0.2
RECONNECT_MAX_DELAY_SECONDS=5.0
# Сколько старт ждёт ответа от PostgreSQL, Redis и Telegram, прежде чем сдаться. Стек,
# который поднимается разом, поднимается не по порядку.
STARTUP_WAIT_SECONDS=60

# --- Ёмкость и перила (docs/deployment.md) ---
# Сколько обновлений обрабатывается одновременно. Не даёт наплыву игроков поставить
# в очередь больше одновременной работы, чем вывезет пул PostgreSQL; 0 снимает
# потолок.
UPDATE_CONCURRENCY_LIMIT=100
# Колбэки медленнее этого отмечает детектор медленных колбэков.
SLOW_CALLBACK_SECONDS=0.1
# Детектору нужен режим отладки asyncio, а он проставляет время каждому колбэку.
# Незаданным он включён для APP_ENV=local и выключен везде, где сидят игроки, — а
# это та сторона, о которой нельзя забыть. Поставьте true, чтобы включить его
# принудительно. SLOW_CALLBACK_DETECTOR=true
#
# Как часто игра записывает, что успела обслужить: обновления, отказы, p50, p95
# (см. mmorpg/metrics.py и docs/deployment.md).
METRICS_SECONDS=60
# Сколько отправок в секунду бот себе позволяет. Telegram считает около тридцати на бота
# целиком; убавлять безопасно, прибавлять — значит зарабатывать 429.
TELEGRAM_SENDS_PER_SECOND=30
# Как часто цикл событий доказывает проверке контейнера, что он жив. Контейнер
# перезапускают после трёх пропущенных ударов.
HEARTBEAT_SECONDS=10
