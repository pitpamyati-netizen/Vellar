# Copy to .env and fill in. Never commit the real .env file.
#
# The Docker stack reads this file as well, but overrides APP_ENV, POSTGRES_DSN
# and REDIS_DSN with the values that point at the containers - see
# docker-compose.yml. Everything else here applies in both cases.

# --- Application ---
# local  = in-memory adapters, no PostgreSQL or Redis required (development)
# dev    = long polling against real PostgreSQL and Redis
# prod   = webhook mode against real PostgreSQL and Redis
APP_ENV=local
LOG_LEVEL=INFO
# JSON logs are forced in prod regardless of this flag.
LOG_JSON=false

# --- Telegram ---
BOT_TOKEN=123456:replace-with-your-token
# Webhook settings are only read when APP_ENV=prod.
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-a-random-string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Community (Roadmap.md, Narrative.md) ---
# The channel the game posts its log to, and the group players talk in. Both take
# a numeric chat id (-100...) or an @username; the bot must be an administrator
# in the channel. Leave empty to turn the feature off - a local run needs neither.
CHANNEL_ID=
GROUP_ID=
# Optional public links shown to players in the bot ("where the others are").
CHANNEL_URL=
GROUP_URL=

# --- World ---
# Changing the seed regenerates the whole procedural world.
WORLD_SEED=vellar-prime
# Length of one world cycle in seconds (6 hours).
CYCLE_SECONDS=21600

# --- PostgreSQL (ignored when APP_ENV=local) ---
POSTGRES_DSN=postgresql://vellar:vellar@localhost:5432/vellar
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20
# Used by docker-compose.yml for the container's superuser password. Change it
# before exposing PostgreSQL beyond loopback.
POSTGRES_PASSWORD=vellar

# --- Redis (ignored when APP_ENV=local) ---
REDIS_DSN=redis://localhost:6379/0

# --- Capacity and guard rails (docs/deployment.md) ---
# Updates handled at the same time. Keeps a burst of players from queueing more
# concurrent work than the PostgreSQL pool can serve; 0 removes the ceiling.
UPDATE_CONCURRENCY_LIMIT=100
# Callbacks slower than this are reported by the slow callback detector.
SLOW_CALLBACK_SECONDS=0.1
# The detector needs asyncio debug mode, which timestamps every callback. Leave
# it on while developing; the Docker stack turns it off for you.
SLOW_CALLBACK_DETECTOR=true
# How often the event loop proves it is alive to the container healthcheck. The
# container is restarted after three missed beats.
HEARTBEAT_SECONDS=10
