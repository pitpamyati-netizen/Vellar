# Copy to .env and fill in. Never commit the real .env file.
#
# The Docker stack reads this file as well, but overrides APP_ENV, POSTGRES_DSN
# and REDIS_DSN with the values that point at the containers - see
# docker-compose.yml. Everything else here applies in both cases.

# --- Application ---
# local  = in-memory adapters, no PostgreSQL or Redis required (development)
# solo   = long polling against a PostgreSQL on this machine, no Redis and no
#          Docker: the world is kept, the screen a player stands on is not
#          (docs/adr/0010-a-machine-without-containers.md)
# dev    = long polling against real PostgreSQL and Redis
# prod   = webhook mode against real PostgreSQL and Redis
APP_ENV=local
LOG_LEVEL=INFO
# JSON logs are forced in prod regardless of this flag.
LOG_JSON=false

# --- Telegram ---
BOT_TOKEN=123456:replace-with-your-token
# Webhook settings are only read when APP_ENV=prod.
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-a-random-string
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Community (Roadmap.md, Narrative.md) ---
# The channel the game posts its log to, and the group players talk in. Both take
# a numeric chat id (-100...) or an @username. The bot must be an administrator in
# the channel to post, and in the group to delete its own messages after five
# minutes. Leave empty to turn the feature off - a local run needs neither.
#
# GROUP_ID=* means "any group the bot has been added to". That is for trying the
# group commands before you know the id: add the bot, write "профиль" in reply to
# somebody, and it answers. With GROUP_ID empty the bot stays silent but writes
# the id of the group it saw into the log (group_not_configured), so the number
# to put here can be read off instead of hunted for.
CHANNEL_ID=
GROUP_ID=
# Optional public links shown to players in the bot ("where the others are").
CHANNEL_URL=
GROUP_URL=

# --- Keepers ---
# Telegram ids the keeper right starts from, comma separated. Empty means nobody
# has it. A keeper walks into any city, hands themselves gold, levels and points,
# and heals; an id on this list also hands the right itself to other players from
# the panel, and cannot be stripped of it from inside the game - see
# docs/keeper.md.
ADMIN_IDS=

# --- World ---
# Changing the seed regenerates the whole procedural world.
WORLD_SEED=vellar-prime
# How often a shop shelf turns over, in seconds (half an hour). The world itself
# has no cycle: a location keeps its map until it is cleared out.
SHOP_ROTATION_SECONDS=1800

# How long a character waits between gatherings of one craft, in seconds.
GATHER_COOLDOWN_SECONDS=900

# --- PostgreSQL (ignored when APP_ENV=local) ---
# In solo mode this is the database on this machine, and it is what
# "Start.bat setup-db" creates: the role vellar with POSTGRES_PASSWORD below,
# owning a database of the same name. Point it elsewhere and it is that one the
# game and the migrations use.
POSTGRES_DSN=postgresql://vellar:vellar@localhost:5432/vellar
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20
# The password for the role the game connects as: used by docker-compose.yml for
# the container, and by "Start.bat setup-db" for a PostgreSQL installed on this
# machine. Change it before exposing PostgreSQL beyond loopback.
POSTGRES_PASSWORD=vellar

# --- Redis (ignored when APP_ENV is local or solo) ---
REDIS_DSN=redis://localhost:6379/0

# --- A link that breaks while the game is running (docs/architecture.md) ---
# A dropped connection is replaced by the pool itself; these govern the call that
# was in the air when it dropped. How many times it is repeated, and the wait
# before each repeat - the wait doubles up to the ceiling. Nothing that may have
# already changed the world is repeated: see
# docs/adr/0009-repeating-a-lost-query.md.
RECONNECT_ATTEMPTS=5
RECONNECT_DELAY_SECONDS=0.2
RECONNECT_MAX_DELAY_SECONDS=5.0
# How long startup waits for PostgreSQL, Redis and Telegram to answer before
# giving up. A stack that comes up together does not come up in order.
STARTUP_WAIT_SECONDS=60

# --- Capacity and guard rails (docs/deployment.md) ---
# Updates handled at the same time. Keeps a burst of players from queueing more
# concurrent work than the PostgreSQL pool can serve; 0 removes the ceiling.
UPDATE_CONCURRENCY_LIMIT=100
# Callbacks slower than this are reported by the slow callback detector.
SLOW_CALLBACK_SECONDS=0.1
# The detector needs asyncio debug mode, which timestamps every callback. Left
# unset it is on for APP_ENV=local and off everywhere players are, which is the
# way round that cannot be forgotten. Set it to true to force it on anyway.
# SLOW_CALLBACK_DETECTOR=true
# How often the game writes down what it served: updates, failures, p50, p95
# (see mmorpg/metrics.py and docs/deployment.md).
METRICS_SECONDS=60
# Sends per second the bot allows itself. Telegram counts about thirty for the
# bot as a whole; lowering this is safe, raising it only earns 429s.
TELEGRAM_SENDS_PER_SECOND=30
# How often the event loop proves it is alive to the container healthcheck. The
# container is restarted after three missed beats.
HEARTBEAT_SECONDS=10
